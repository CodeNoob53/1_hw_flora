# Base URL for API requests.
# Local dev with json-server: keep "/api" (Vite proxies it to http://127.0.0.1:3001).
VITE_API_BASE_URL="/api"

# Static hosting (GitHub Pages): the build emits dist/api/*.json and the client
# reads those files instead of calling json-server. Set automatically in CI.
# VITE_API_MODE=static
